<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_progress_card"
    android:padding="24dp">

    <!-- Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💾"
            android:textSize="22sp"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salvar rota"
            android:textColor="#1A1A1A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

    </LinearLayout>

    <!-- Route info pill -->
    <TextView
        android:id="@+id/tvSaveRouteCostInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_purple"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="#4A2080"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="20dp"/>

    <!-- Name field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome da rota *"
        android:textColor="#555555"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etRouteName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="14dp"
        android:hint="Ex: Fim de semana em São Paulo"
        android:textSize="14sp"
        android:textColor="#1A1A1A"
        android:inputType="textCapSentences"
        android:layout_marginBottom="16dp"/>

    <!-- Description field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descrição (opcional)"
        android:textColor="#555555"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etRouteDescription"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:hint="Conte um pouco sobre essa rota..."
        android:textSize="14sp"
        android:textColor="#1A1A1A"
        android:inputType="textMultiLine|textCapSentences"
        android:gravity="top"
        android:layout_marginBottom="24dp"/>

    <!-- Buttons -->
    <Button
        android:id="@+id/btnConfirmSave"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#4A2080"
        android:text="Salvar rota"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvCancelSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancelar"
        android:textColor="#888888"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingVertical="8dp"/>

</LinearLayout>
