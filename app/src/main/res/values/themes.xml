<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="CircleImageView">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Theme.OwnMyWay" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/omw_purple_main</item>
        <item name="colorPrimaryVariant">@color/omw_purple_dark</item>
        <item name="colorOnPrimary">@color/omw_on_primary</item>
        <item name="colorSecondary">@color/omw_purple_light</item>
        <item name="colorSecondaryVariant">@color/omw_purple_mid</item>
        <item name="colorOnSecondary">@color/omw_on_primary</item>
        <item name="android:windowBackground">@color/omw_background</item>
        <item name="android:colorAccent">@color/omw_purple_main</item>
        <item name="android:statusBarColor">@color/omw_background</item>
        <item name="android:navigationBarColor">@color/omw_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Theme.OwnMyWay.NoActionBar" parent="Theme.OwnMyWay">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.OwnMyWay.Splash" parent="Theme.OwnMyWay.SplashFixed" />

    <style name="Theme.OwnMyWay.SplashFixed" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#0F0626</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.OwnMyWay.RegisterFixed" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
