<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical"
    android:background="@color/omw_surface_variant"> <TextView
    android:id="@+id/tvTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Crie uma nova senha"
    android:textColor="@color/omw_purple_main"
    android:textSize="24sp"
    android:textStyle="bold"
    android:gravity="center"
    android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seu link foi validado com sucesso. Digite sua nova senha de acesso abaixo."
        android:textColor="@color/omw_purple_main"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Nova Senha"
        app:hintTextColor="@color/omw_purple_main"
        app:boxStrokeColor="@color/omw_purple_main"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/omw_purple_main"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:inputType="textPassword"
            android:textSize="16sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnUpdatePassword"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Atualizar Senha"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/omw_on_primary"
        android:backgroundTint="@color/omw_purple_main"
        app:cornerRadius="8dp"
        android:elevation="4dp"/>

</LinearLayout>
